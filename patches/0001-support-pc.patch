From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jqssun <jqssun+git@googlemail.com>
Date: Tue, 28 Apr 2026 21:10:56 -0700
Subject: [PATCH] support pc


diff --git a/app/src/main/java/com/atharok/btremote/common/utils/Constants.kt b/app/src/main/java/com/atharok/btremote/common/utils/Constants.kt
index 51770bd..03fdb45 100644
--- a/app/src/main/java/com/atharok/btremote/common/utils/Constants.kt
+++ b/app/src/main/java/com/atharok/btremote/common/utils/Constants.kt
@@ -42,3 +42,3 @@ const val DELAY_BETWEEN_KEY_PRESSES_IN_MILLIS = 25L
 
-const val USE_MOUSE_NAVIGATION_BY_DEFAULT = false
+const val USE_MOUSE_NAVIGATION_BY_DEFAULT = true
 
@@ -47,4 +47,4 @@ const val USE_MOUSE_NAVIGATION_BY_DEFAULT = false
 const val KEYBOARD_REPORT_ID = 0x01
-const val REMOTE_REPORT_ID = 0x02
-const val MOUSE_REPORT_ID = 0x03
+const val MOUSE_REPORT_ID = 0x02
+const val REMOTE_REPORT_ID = 0x03
 
diff --git a/app/src/main/java/com/atharok/btremote/data/bluetooth/BluetoothHidCore.kt b/app/src/main/java/com/atharok/btremote/data/bluetooth/BluetoothHidCore.kt
index 820b81f..2e2ec96 100644
--- a/app/src/main/java/com/atharok/btremote/data/bluetooth/BluetoothHidCore.kt
+++ b/app/src/main/java/com/atharok/btremote/data/bluetooth/BluetoothHidCore.kt
@@ -152,2 +152,11 @@ class BluetoothHidCore(
 
+    private fun sendAndroidReport(
+        hidDevice: BluetoothHidDevice,
+        device: BluetoothDevice,
+        id: Int,
+        bytes: ByteArray
+    ): Boolean {
+        return hidDevice.sendReport(device, id, bytes)
+    }
+
     fun sendReport(id: Int, bytes: ByteArray): Boolean {
@@ -157,3 +166,3 @@ class BluetoothHidCore(
                 if (checkBluetoothConnectPermission(context)) {
-                    success = hidDevice.sendReport(device, id, bytes)
+                    success = sendAndroidReport(hidDevice, device, id, bytes)
                 }
@@ -175,3 +184,3 @@ class BluetoothHidCore(
                     text.forEach {
-                        if(!hidDevice.sendReport(device, KEYBOARD_REPORT_ID, virtualKeyboardLayout.getKeyboardKey(it))) {
+                        if(!sendAndroidReport(hidDevice, device, KEYBOARD_REPORT_ID, virtualKeyboardLayout.getKeyboardKey(it))) {
                             success = false
@@ -179,3 +188,3 @@ class BluetoothHidCore(
                         delay(DELAY_BETWEEN_KEY_PRESSES_IN_MILLIS)
-                        hidDevice.sendReport(device, KEYBOARD_REPORT_ID, REMOTE_INPUT_NONE)
+                        sendAndroidReport(hidDevice, device, KEYBOARD_REPORT_ID, REMOTE_INPUT_NONE)
                         delay(DELAY_BETWEEN_KEY_PRESSES_IN_MILLIS)
@@ -183,5 +192,5 @@ class BluetoothHidCore(
                     if(shouldSendEnter) {
-                        hidDevice.sendReport(device, KEYBOARD_REPORT_ID, RemoteButtonProperties.KeyboardEnterButton.input)
+                        sendAndroidReport(hidDevice, device, KEYBOARD_REPORT_ID, RemoteButtonProperties.KeyboardEnterButton.input)
                         delay(DELAY_BETWEEN_KEY_PRESSES_IN_MILLIS)
-                        hidDevice.sendReport(device, KEYBOARD_REPORT_ID, REMOTE_INPUT_NONE)
+                        sendAndroidReport(hidDevice, device, KEYBOARD_REPORT_ID, REMOTE_INPUT_NONE)
                     }
